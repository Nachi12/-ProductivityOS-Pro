{
  "openapi": "3.0.3",
  "info": {
    "title": "ProductivityOS Pro - Personal Finance SaaS API",
    "description": "Production-grade MERN RESTful API for multi-user personal financial management, money calculations, idempotent bank statement parsing, duplicate detection, and analytics.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "API Health Check",
        "responses": {
          "200": { "description": "Service is operational" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register new user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "displayName": { "type": "string" }
                },
                "required": ["email", "password", "displayName"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully" },
          "400": { "description": "Registration error or duplicate email" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user and issue JWT token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authenticated successfully" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/transactions": {
      "get": {
        "summary": "List paginated user transactions with filtering",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["INCOME", "EXPENSE"] } },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "List of transactions" }
        }
      },
      "post": {
        "summary": "Create new transaction",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Transaction created" }
        }
      }
    },
    "/statements/upload": {
      "post": {
        "summary": "Upload and parse bank statement for transaction extraction & duplicate detection",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Statement parsed successfully" }
        }
      }
    },
    "/analytics/summary": {
      "get": {
        "summary": "Get financial summary (Net cash flow, savings rate, EMI, category breakdown)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Summary analytics payload" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
